{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"*": [
				"./*"
			],
			"@ponythewhite/base-context-ai": [
				"./packages/ai/src/index.ts"
			],
			"@ponythewhite/base-context-ai/oauth": [
				"./packages/ai/src/oauth.ts"
			],
			"@ponythewhite/base-context-ai/*": [
				"./packages/ai/src/*.ts",
				"./packages/ai/src/providers/*.ts"
			],
			"@ponythewhite/base-context-ai/dist/*": [
				"./packages/ai/src/*"
			],
			"@ponythewhite/base-context-agent": [
				"./packages/agent/src/index.ts"
			],
			"@ponythewhite/base-context-agent/*": [
				"./packages/agent/src/*"
			],
			"@ponythewhite/base-context": [
				"./packages/coding-agent/src/index.ts"
			],
			"@ponythewhite/base-context/hooks": [
				"./packages/coding-agent/src/core/hooks/index.ts"
			],
			"@ponythewhite/base-context/*": [
				"./packages/coding-agent/src/*"
			],
			"typebox": [
				"./node_modules/typebox"
			],
			"@ponythewhite/base-context-tui": [
				"./packages/tui/src/index.ts"
			],
			"@ponythewhite/base-context-tui/*": [
				"./packages/tui/src/*"
			]
		}
	},
	"include": [
		"packages/*/src/**/*",
		"packages/*/test/**/*",
		"packages/coding-agent/examples/**/*"
	],
	"exclude": [
		"**/dist/**"
	]
}
