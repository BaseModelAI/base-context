{
	"name": "@ponythewhite/base-context-tui",
	"version": "1.0.8",
	"description": "Synerise base-context terminal UI components",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "node --test --import tsx test/*.test.ts",
		"prepublishOnly": "npm --prefix ../.. run build:source"
	},
	"files": [
		"dist/**/*",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Jacek Dąbrowski <jack.dabrowski@synerise.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BaseModelAI/base-context.git",
		"directory": "packages/tui"
	},
	"engines": {
		"node": "^22.12.0 || >=23.3.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@types/mime-types": "^3.0.1",
		"chalk": "^5.5.0",
		"get-east-asian-width": "^1.6.0",
		"marked": "^18.0.7",
		"mime-types": "^3.0.1"
	},
	"optionalDependencies": {
		"koffi": "^2.9.0"
	},
	"devDependencies": {
		"@xterm/headless": "^6.0.0",
		"@xterm/xterm": "^6.0.0"
	},
	"contributors": [
		"Mario Zechner",
		"Prime Intellect",
		"BaseModelAI"
	],
	"homepage": "https://github.com/BaseModelAI/base-context#readme",
	"publishConfig": {
		"access": "public"
	}
}
